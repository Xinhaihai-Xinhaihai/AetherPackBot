[Unit]
Description=AetherPackBot Harbor + Brain
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aetherpack
Group=aetherpack
WorkingDirectory=/opt/aetherpackbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aetherpackbot/.venv/bin/python /opt/aetherpackbot/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
