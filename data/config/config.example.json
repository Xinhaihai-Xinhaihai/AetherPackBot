{
  "version": "1.0.0",
  "debug": false,
  "web": {
    "host": "0.0.0.0",
    "port": 7619,
    "enable_cors": true,
    "admin_username": "aetherpackbot",
    "admin_password": "aetherpackbot",
    "jwt_secret": ""
  },
  "logging": {
    "level": "INFO",
    "log_dir": "data/logs"
  },
  "database": {
    "url": "sqlite+aiosqlite:///data/storage/aetherpackbot.db"
  },
  "platforms": [],
  "providers": [
    {
      "id": "ppo",
      "name": "PPO Compat Gate",
      "type": "openai_compat",
      "lane": "cloud",
      "api_key": "YOUR_KEY",
      "api_base_url": "https://api.futureppo.top/v1",
      "model": "deepseek-v4-flash",
      "timeout": 60,
      "enabled": true,
      "capabilities": {
        "temperature": 0.7,
        "enable_tools": true,
        "enable_vision": false,
        "enable_text": true,
        "max_tokens": 4096,
        "stream": false
      }
    },
    {
      "id": "huachuan",
      "name": "Huachuan Compat Gate",
      "type": "openai_compat",
      "lane": "cloud",
      "api_key": "YOUR_KEY",
      "api_base_url": "http://91vip.txvlogvip.top:3000/v1",
      "model": "MiniMax-M2.7",
      "timeout": 60,
      "enabled": true,
      "capabilities": {
        "temperature": 0.4,
        "enable_tools": true,
        "enable_vision": true,
        "enable_text": true,
        "max_tokens": 8192,
        "stream": false
      }
    },
    {
      "id": "k3",
      "name": "K3 TokenRouter",
      "type": "openai_compat",
      "lane": "cloud",
      "api_key": "YOUR_KEY",
      "api_base_url": "https://api.tokenrouter.com/v1",
      "model": "qwen/qwen3.5-9b",
      "timeout": 60,
      "enabled": true,
      "capabilities": {
        "temperature": 0.2,
        "enable_tools": false,
        "enable_vision": false,
        "enable_text": true,
        "max_tokens": 2048,
        "stream": false
      }
    },
    {
      "id": "local-ollama",
      "name": "Local Ollama",
      "type": "ollama",
      "lane": "local",
      "api_key": "ollama",
      "api_base_url": "http://127.0.0.1:11434/v1",
      "model": "llama3",
      "timeout": 20,
      "enabled": true,
      "capabilities": {
        "temperature": 0.8,
        "enable_tools": false,
        "enable_vision": false,
        "enable_text": true,
        "max_tokens": null,
        "stream": false
      }
    }
  ],
  "mcp": {
    "servers": [
      {
        "id": "filesystem",
        "name": "Filesystem MCP",
        "enabled": true,
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "D:/AetherPackBot/data"],
        "env": {},
        "cwd": "",
        "timeout": 30,
        "bind_models": ["ppo", "huachuan"]
      },
      {
        "id": "remote-search",
        "name": "Remote Search MCP",
        "enabled": false,
        "transport": "http",
        "url": "https://mcp.example.com/mcp",
        "headers": {
          "Authorization": "Bearer YOUR_MCP_TOKEN"
        },
        "timeout": 30,
        "bind_models": ["ppo", "k3", "local-ollama"]
      },
      {
        "id": "sse-tools",
        "name": "SSE MCP",
        "enabled": false,
        "transport": "sse",
        "url": "https://mcp.example.com/sse",
        "headers": {},
        "timeout": 30,
        "bind_models": []
      }
    ]
  },
  "plugins": {
    "enabled": true,
    "directory": "data/plugins",
    "auto_update": false
  },
  "agent": {
    "default_provider": "ppo",
    "max_tool_steps": 30,
    "tool_timeout": 60,
    "wake_prefixes": ["/", "!"],
    "wake_words": []
  },
  "moderation": {
    "enabled": false,
    "rate_limit_enabled": true,
    "rate_limit_per_minute": 30
  },
  "reply": {
    "add_prefix": false,
    "prefix_template": "[AetherPackBot] ",
    "at_sender": false,
    "quote_original": false
  },
  "personas": [],
  "default_persona": "",
  "subagents": []
}
